    {
      "doc_id": "ST.concordance_factor",
      "text": "統法千五百三十九．以閏法乘日法，得統法．",
      "source": {
        "work": "C2017",
        "printed_pages": [
          41
        ],
        "pdf_pages": [
          54
        ]
