{
  "name": "eleventy-symbolic-math",
  "version": "1.0.0",
  "description": "A symbolic math exploration site using Eleventy",
  "scripts": {
    "setup:mac": "bash scripts/setup-mac.sh",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "verify:install": "node scripts/verify-install.mjs",
    "generate:debug-flags-doc": "node scripts/generate-debug-flags-doc.mjs",
    "generate:log-by-tag": "node scripts/generate-log-by-tag.mjs",
    "extract:cullen-pages": "node scripts/extract-cullen-pages.mjs",
    "build:cullen-chunks": "node scripts/build-cullen-chunks.mjs",
    "build:cullen-search-index": "node scripts/build-cullen-search-index.mjs",
    "extract:cullen-claims": "node scripts/extract-cullen-claims.mjs",
    "assimilate:cullen": "node scripts/assimilate-cullen.mjs",
    "audit:cullen-chapter-coverage": "node scripts/audit-cullen-chapter-coverage.mjs",
    "audit:cullen-procedure-completeness": "node scripts/audit-cullen-procedure-completeness.mjs",
    "audit:cullen-procedure-anchors": "node scripts/audit-cullen-procedure-anchors.mjs",
    "audit:cullen-anchor-quality": "node scripts/audit-cullen-anchor-quality.mjs",
    "audit:cullen-target-span-alignment": "node scripts/audit-cullen-target-span-alignment.mjs",
    "audit:sifen-target-family-candidates": "node scripts/audit-sifen-target-family-candidates.mjs",
    "audit:source-cullen-alignment": "node scripts/audit-source-cullen-alignment.mjs",
    "audit:cullen-led-source-reconstruction": "node scripts/audit-cullen-led-source-reconstruction.mjs",
    "align:cullen-procedure-ir": "node scripts/align-cullen-procedure-ir.mjs",
    "audit:cullen-oracle": "node scripts/audit-cullen-oracle.mjs",
    "query:cullen-page": "node scripts/query-cullen-page.mjs",
    "query:cullen-proc": "node scripts/query-cullen-proc.mjs",
    "query:cullen-source": "node scripts/query-cullen-source.mjs",
    "build:cullen-pattern-index": "node scripts/build-cullen-pattern-index.mjs",
    "build:procedure-ir": "node scripts/build-procedure-ir.mjs",
    "build:ctext-cache": "node scripts/build-ctext-cache.mjs",
    "promote:ctext-cache": "node scripts/build-ctext-cache.mjs --promote tmp/ctext-static-build/ctext-cache.candidate.json",
    "test:ctext-stats-parser": "node --test tests/ctext-stats-parser.test.mjs",
    "start:ctext-proxy": "node server/ctextProxyServer.js",
    "prestart": "npm run generate:debug-flags-doc && npm run generate:log-by-tag",
    "start": "npx eleventy --serve",
    "prebuild": "npm run generate:debug-flags-doc && npm run generate:log-by-tag",
    "build": "npx eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.0",
    "playwright": "^1.58.2"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
